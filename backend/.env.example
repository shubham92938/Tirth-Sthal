# ── Tirthstal Backend Environment ──
# Copy this file to `.env` and fill in your values:  cp .env.example .env

# Port — frontend (tirthstal/.env) expects the API at http://localhost:3000/api
PORT=3000

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/tirthstal

# JWT auth
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRE=7d

# Frontend origin(s) for CORS + password-reset links.
# Multiple origins can be comma-separated.
CLIENT_URL=http://localhost:5173

# Email (password reset) — e.g. Gmail SMTP with an App Password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
